# Control plane, local development against deploy/compose/docker-compose.dev.yml.
# Copy to .env (git-ignored). Development values only; production gets these from its secret store.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Application role: DML only, cannot change the schema or rewrite audit events.
DATABASE_URL=postgres://qews_app_login:devonly-app@127.0.0.1:5432/qews
# Migrator role, used only by `npm run migrate -w @qe/control-plane`.
MIGRATION_DATABASE_URL=postgres://qews:devonly@127.0.0.1:5432/qews
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# dev: every request acts as a seeded "dev" user with DEV_ROLES (refused when NODE_ENV=production).
# oidc: sign in through the compose Keycloak (users alice/dev-alice, bob/dev-bob, admin/dev-admin, audrey/dev-audrey).
AUTH_MODE=dev
DEV_ROLES=qe.user
OIDC_ISSUER=http://localhost:8081/realms/qe
OIDC_CLIENT_ID=qe-workspace
OIDC_CLIENT_SECRET=dev-only-qe-workspace-client-secret
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
ROLE_MAPPINGS={"qe-workspace-users":["qe.user"],"qe-workspace-leads":["qe.lead"],"qe-workspace-admins":["qe.admin","qe.user"],"qe-auditors":["auditor"],"qe-lab-a":["lab.a.user"]}
# Development only: 32+ random characters in any shared environment (signs the login transaction cookie).
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Plain http on localhost; production refuses false.
COOKIE_SECURE=false
LOG_LEVEL=info
# Workspace runtimes (Phase 05). docker: containers on this machine (Docker Desktop / Engine must be running);
# kubernetes: pods in K8S_NAMESPACE (in-cluster only); local: no runtimes (desktop / local web).
RUNTIME_KIND=docker
RUNTIME_NETWORK=qews-workspaces
# published: the IDE port is published on 127.0.0.1 so this host-run control plane can reach it.
RUNTIME_ENDPOINT_MODE=published
WORKSPACE_START_TIMEOUT_SEC=180
WORKSPACE_IDLE_MINUTES=60
MAX_RUNNING_WORKSPACES_PER_USER=2
# Remote targets (Phase 07). Extra networks no target may resolve to (cluster pod/service CIDRs, platform networks).
TARGET_DENY_CIDRS=
SESSION_TICKET_TTL_SEC=60
# Shared secret for the broker's /internal/* calls (development only; mTLS in Phase 16). Unset = internal routes off.
# INTERNAL_SERVICE_TOKEN=
# Connection broker (Phase 08). Same token as the broker's INTERNAL_SERVICE_TOKEN.
# BROKER_INTERNAL_URL=http://127.0.0.1:8082
# BROKER_PUBLIC_URL=http://localhost:8082
