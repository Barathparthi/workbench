# Connection broker, local development against the control plane in apps/control-plane.
# Copy to .env (git-ignored). Development values only.
NODE_ENV=development
HOST=127.0.0.1
PORT=8082
LOG_LEVEL=info
CONTROL_PLANE_INTERNAL_URL=http://127.0.0.1:8080
# Same value as the control plane's INTERNAL_SERVICE_TOKEN (32+ characters).
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-change-me-0123
# Origins the IDE runs on (same as the control plane's ALLOWED_ORIGINS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Networks no target may resolve to, besides the built-in denials (cluster/platform networks).
TARGET_DENY_CIDRS=
# Development only: private key files for `file_dev` credential references (refused in production).
DEV_CREDENTIALS_DIR=./dev-keys
