{
  "name": "qe-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "QE Workspace \u2014 VS Code-like IDE for browser and desktop with brokered SSH to lab systems",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "extensions/*",
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build",
    "clean": "node scripts/clean.mjs",
    "check:theia-versions": "vitest run --project unit tests/lint/theia-versions.test.ts",
    "plugins:download": "node scripts/plugins.ts download",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "electron": "42.11.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@theia/ffmpeg@1.76.0": true,
    "cpu-features@0.0.10": false,
    "drivelist@12.0.2": true,
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true,
    "msgpackr-extract@3.0.4": true,
    "native-keymap@2.5.0": true,
    "node-pty@1.2.0-beta.12": true,
    "protobufjs@7.6.6": false,
    "puppeteer@25.1.0": false,
    "ssh2@1.17.0": false,
    "unrs-resolver@1.12.2": false
  }
}
