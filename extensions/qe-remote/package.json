{
  "name": "@qe/theia-qe-remote",
  "version": "0.0.0",
  "private": true,
  "description": "QE Workspace remote connections: managed targets through the connection broker and personal targets through the embedded broker (ADR-006 option B, ADR-008).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "keywords": [
    "theia-extension"
  ],
  "files": [
