  },
  "dependencies": {
    "@qe/broker-core": "0.0.0",
    "@qe/contracts": "0.0.0",
    "@qe/policy": "0.0.0",
    "@qe/theia-qe-core": "0.0.0",
    "@theia/core": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "jsonc-parser": "3.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/qe-remote-frontend-module",
