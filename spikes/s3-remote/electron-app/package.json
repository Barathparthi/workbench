{
  "name": "electron-app",
  "version": "0.0.0",
  "private": true,
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/electron": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "qe-remote-b": "0.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "electron": "42.8.1"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "bundle:napi": "theia build --mode development",
    "start": "theia start --plugins=local-dir:../vscode-plugins"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "QE Workspace (S3 electron)"
      }
    }
  }
}
