{
  "name": "browser-app",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "qe-hello": "0.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "theia start --hostname 127.0.0.1 --port 3000"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "QE Workspace (S1 browser)"
      }
    }
  }
}
